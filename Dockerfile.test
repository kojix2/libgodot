FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV GC_MARKERS=1

# Install base toolchain, LLDB, and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    wget \
    unzip \
    libgc-dev \
    libyaml-dev \
    libpcre2-dev \
    libevent-dev \
    lld \
    lldb \
    gdb \
    ca-certificates \
    libgl1-mesa-dri \
    libgl1-mesa-glx \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install Crystal compiler
RUN curl -fsSL https://crystal-lang.org/install.sh | bash

# Download Godot 4.8-dev4 headless Linux binary
WORKDIR /opt/godot
RUN wget -q https://github.com/godotengine/godot-builds/releases/download/4.8-dev4/Godot_v4.8-dev4_linux.x86_64.zip -O godot.zip \
    && unzip -q godot.zip \
    && mv Godot_v4.8-dev4_linux.x86_64 /usr/local/bin/godot \
    && chmod +x /usr/local/bin/godot \
    && rm godot.zip

ENV GODOT4=/usr/local/bin/godot
ENV GODOT=/usr/local/bin/godot

WORKDIR /workspace

# Default command runs full workspace build and test suite
CMD ["make", "all"]
